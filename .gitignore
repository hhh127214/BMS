# =====================================================================
#  .gitignore  for  BMS  project
# =====================================================================

# Compiled C / C++
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.exp
*.so
*.dylib

# Build output directories
**/build/
**/out/
**/logs/
**/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# VSCode / IntelliJ
.vscode/
.idea/
*.swp
*.swo

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Temporary outputs
*.bak
*.tmp
*.log

# Read-only snapshots from external projects (do NOT commit)
/code/

# PPT 生成过程产物（.cache / output / 验收器自检临时报告）
**/.cache/
**/output/
12/data/_report_selftest/

# 全量构建日志（运行期产物，可随时重跑）
build_all.log

# 本地工作记忆（过程性记录，仅本地保留）
.workbuddy/
