# =====================================================================
#  .gitignore  for  BMS  project
# =====================================================================

# Compiled C / C++
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.exp
*.so
*.dylib

# Build output directories
**/build/
**/out/
**/logs/
**/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# VSCode / IntelliJ
.vscode/
.idea/
*.swp
*.swo

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Temporary outputs
*.bak
*.tmp
*.log

# Read-only snapshots from external projects (do NOT commit)
/code/

# PPT 生成过程产物（.cache / output / 验收器自检临时报告）
**/.cache/
**/output/
12/data/_report_selftest/

# 全量构建日志（运行期产物，可随时重跑）
build_all.log

# 本地工作记忆（过程性记录，仅本地保留）
.workbuddy/

# 平台层数据库（派生自 10/build 的仿真产物，由 14/scripts/import_sim.bat 重建；
# 4.7 MB，且含默认口令哈希 —— 不入库）
14/data/ems.db
14/data/ems.db-wal
14/data/ems.db-shm

# 站级交付包（派生产物：含 ems.db 快照与打包 zip，不入库）
/ems-demo/
/ems-demo-站级监控交付包.zip

# ---------------------------------------------------------------------
#  运行期产物（可重建，不入库）
# ---------------------------------------------------------------------

# 点表与接入参数：平台「设备管理」页保存时才生成，属于**运行期配置**，
# 不是源码。仓库里只保留 13/docs/point_map_template.csv 作为格式样例。
/config/point-map/

# 运行模式（engine=run）下实时引擎写的实录 CSV：
# 按墙钟时间戳命名，一天就是几十 MB，且随时在长 —— 绝不能进版本库。
14/data/live/

# 仿真页（engine=sim）日/周/月仿真的产物目录：
# 每份含 summary.json / timeseries.csv / alarms.csv / report.html，
# 月仿真单份就有十几 MB。它们是**结果**，由页面「发起仿真」重建。
14/data/simruns/

# ---------------------------------------------------------------------
#  调试临时物（历次排查留下的截图与日志，不入库）
# ---------------------------------------------------------------------
# 根目录探针截图/日志（_shot_*.png、_pv*.png、_*.log、_ov.json 等）
/_*
# 15/ 前端截图与量尺寸的一次性脚手架
15/tests/_*
# 14/ 后端探针脚本
14/tests/_probe_live.py
# 14/ 告警维度探针（scripts/probe_alarm_dims.py）的输出：结论性文本，可随时重跑
14/.probe_*
# 全量构建的临时包装脚本
scripts/_run_build_all_tmp.bat
# 18/ 基准的多次重复验证脚本（编译 + 连跑 4 次，抽 P4/R8c/R13 明细）
scripts/_run18.py
# 排查 / 验证用的一次性输出（根目录，点号开头）：
# .bl*.txt（baseline 明细）、.st1*.txt（自检输出）、.port*.txt（端口探测）、
# .gs/.gitstat.txt（git 状态）、.pid*.txt、.srv*.err
# ★ 它们不是洁癖问题：混在工作区里，`git add .` 会把它们一起带进提交。
/.*.txt
/.*.err

# ---------------------------------------------------------------------
#  Word / WPS 打开文档时生成的锁文件（~$xxx.docx，162 字节）
# ---------------------------------------------------------------------
# 它记录「谁正在编辑」，关掉 Word 就没了 —— 不是内容，不该入库。
~$*

# ---------------------------------------------------------------------
#  操作说明书：只留最新一版，旧修订不入库
# ---------------------------------------------------------------------
# 同一份说明书存了 V1.0 / 更新版 / V1.15 / 最终版 四个 docx（各 6~10 MB），
# 内容 95% 相同。**历史交给 git 管**，不必把四个副本都塞进仓库。
# 入库的是：V1.15操作说明书_最终版.docx（与 pdf 同一次导出，内容一致）。
/docs/说明书/工商业储能EMS运行监控平台V1.0*
/docs/说明书/工商业储能EMS运行监控平台V1.15操作说明书.docx

# 平台库的 0 字节残留（从 14/ 目录直接跑起来时会在那儿建一个空的 ems.db）
/14/ems.db
