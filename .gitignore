# =====================================================================
#  .gitignore  for  BMS  project
# =====================================================================

# Compiled C / C++
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.exp
*.so
*.dylib

# Build output directories
**/build/
**/out/
**/logs/
**/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# VSCode / IntelliJ
.vscode/
.idea/
*.swp
*.swo

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Temporary outputs
*.bak
*.tmp
*.log

# Read-only snapshots from external projects (do NOT commit)
/code/

# PPT 工作目录（含 .cache/ .slidep/ slides_old/ 等中间产物与多版备份，不纳入版本控制）
docs/ppt/

# 本地工作记忆（过程性记录，仅本地保留）
.workbuddy/
