<Slide padding={0}>

    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        flexDirection: 'column',
        padding: 0,
        position: 'relative',
    }}>

        {/* A 区：标题 */}
        <Box style={{ padding: '36px 60px 0', flexDirection: 'row', alignItems: 'flex-end' }}>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 16, color: '#3B82F6', fontWeight: 'bold', letterSpacing: 2 }}>
                    系统全貌 · WHERE WE STAND
                </Text>
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1A1A1A', marginTop: 6 }}>
                    EMS 是一个实时调度系统——4 层闭环
                </Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 14, color: '#64748B' }}>
                    P02 / 11
                </Text>
            </Box>
        </Box>

        {/* B 区：4 层架构大图 */}
        <Box style={{
            flex: 1,
            padding: '16px 60px 0',
            flexDirection: 'column',
            gap: 12,
        }}>

            {/* 闭环箭头 SVG */}
            <Box style={{ height: 360 }}>
                <svg width='100%' height='100%' viewBox='0 0 1040 340'>

                    {/* 闭环指示 — 4 层外围虚线箭头 */}
                    <path d='M 80 240 L 80 80 L 980 80 L 980 240 L 60 240' stroke='#CBD5E1'
                          strokeWidth='1.5' fill='none' strokeDasharray='6 4' marker-end='url(#arr)' />
                    <defs>
                        <marker id='arr' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='6' markerHeight='6' orient='auto'>
                            <path d='M 0 0 L 10 5 L 0 10 z' fill='#94A3B8' />
                        </marker>
                    </defs>

                    {/* ===== 第 1 层：数据采集 ===== */}
                    <rect x='90' y='40' width='870' height='52' rx='8' fill='#F1F5F9' stroke='#94A3B8' strokeWidth='1' />
                    <text x='110' y='72' fill='#475569' fontSize='16' fontFamily='Source Han Sans SC' fontWeight='bold'>第一层 · 数据采集</text>
                    <text x='270' y='72' fill='#1A1A1A' fontSize='15' fontFamily='Source Han Sans SC'>
                        电池电量 / 设备功率 / 电网负荷 / 电价 / 调度信号
                    </text>
                    <text x='940' y='56' textAnchor='end' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>↳ 已有</text>
                    <text x='940' y='76' textAnchor='end' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>历史数据</text>

                    {/* ===== 第 2 层：经济调度 = 本次交付的核心 ===== */}
                    <rect x='60' y='110' width='930' height='90' rx='10' fill='#EFF6FF' stroke='#3B82F6' strokeWidth='3' />
                    <rect x='60' y='110' width='6' height='90' fill='#3B82F6' />
                    <text x='86' y='138' fill='#1E40AF' fontSize='17' fontFamily='Source Han Sans SC' fontWeight='bold'>第二层 · 经济调度（本次核心）</text>
                    <text x='86' y='158' fill='#1A1A1A' fontSize='15' fontFamily='Source Han Sans SC'>
                        9 条业务诉求 + 共同语言 + 调度台 + 仲裁规则
                    </text>
                    <text x='86' y='180' fill='#1E40AF' fontSize='14' fontFamily='Source Han Sans SC' fontWeight='bold'>
                        ◀ 前 4 周交付的就是这一层
                    </text>

                    {/* 4 个子块 */}
                    <rect x='420' y='120' width='138' height='70' rx='6' fill='#FFFFFF' stroke='#3B82F6' strokeDasharray='2 2' />
                    <text x='489' y='144' textAnchor='middle' fill='#1E40AF' fontSize='14' fontFamily='Source Han Sans SC' fontWeight='bold'>9 条诉求</text>
                    <text x='489' y='162' textAnchor='middle' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>第 1 周</text>
                    <text x='489' y='180' textAnchor='middle' fill='#1E40AF' fontSize='13' fontFamily='Source Han Sans SC'>理清意志</text>

                    <rect x='566' y='120' width='138' height='70' rx='6' fill='#FFFFFF' stroke='#06B6D4' strokeDasharray='2 2' />
                    <text x='635' y='144' textAnchor='middle' fill='#0E7490' fontSize='14' fontFamily='Source Han Sans SC' fontWeight='bold'>共同语言</text>
                    <text x='635' y='162' textAnchor='middle' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>第 2 周</text>
                    <text x='635' y='180' textAnchor='middle' fill='#0E7490' fontSize='13' fontFamily='Source Han Sans SC'>区间表示</text>

                    <rect x='712' y='120' width='138' height='70' rx='6' fill='#FFFFFF' stroke='#22C55E' strokeDasharray='2 2' />
                    <text x='781' y='144' textAnchor='middle' fill='#166534' fontSize='14' fontFamily='Source Han Sans SC' fontWeight='bold'>调度台</text>
                    <text x='781' y='162' textAnchor='middle' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>第 3 周</text>
                    <text x='781' y='180' textAnchor='middle' fill='#166534' fontSize='13' fontFamily='Source Han Sans SC'>每分钟调度</text>

                    <rect x='858' y='120' width='124' height='70' rx='6' fill='#FFFFFF' stroke='#EF4444' strokeDasharray='2 2' />
                    <text x='920' y='144' textAnchor='middle' fill='#B91C1C' fontSize='14' fontFamily='Source Han Sans SC' fontWeight='bold'>仲裁</text>
                    <text x='920' y='162' textAnchor='middle' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>第 4 周</text>
                    <text x='920' y='180' textAnchor='middle' fill='#B91C1C' fontSize='13' fontFamily='Source Han Sans SC'>冲突解决</text>

                    {/* ===== 第 3 层：实时执行 ===== */}
                    <rect x='90' y='218' width='870' height='44' rx='8' fill='#F1F5F9' stroke='#94A3B8' strokeWidth='1' />
                    <text x='110' y='244' fill='#475569' fontSize='16' fontFamily='Source Han Sans SC' fontWeight='bold'>第三层 · 实时执行</text>
                    <text x='270' y='244' fill='#1A1A1A' fontSize='15' fontFamily='Source Han Sans SC'>
                        防逆流 / 变压器限容 / 需量管理 / 光伏平抑 4 个实时控制器
                    </text>

                    {/* ===== 第 4 层：状态管理 ===== */}
                    <rect x='90' y='280' width='870' height='44' rx='8' fill='#F1F5F9' stroke='#94A3B8' strokeWidth='1' />
                    <text x='110' y='306' fill='#475569' fontSize='16' fontFamily='Source Han Sans SC' fontWeight='bold'>第四层 · 状态管理</text>
                    <text x='270' y='306' fill='#1A1A1A' fontSize='15' fontFamily='Source Han Sans SC'>
                        状态机 / 启停 / 告警 / 人机交互 — 决定"算法层的结果能不能用、什么时候用"
                    </text>

                </svg>
            </Box>

            {/* 底部要点 — 3 个判断句 + 原理补充 */}
            <Box style={{
                flexDirection: 'row',
                gap: 14,
                paddingBottom: 4,
            }}>
                <Box style={{ flex: 1, padding: '12px 16px', background: '#F8FAFC', borderRadius: 8, borderLeft: '3px solid #3B82F6' }}>
                    <Text style={{ fontSize: 13, color: '#3B82F6', fontWeight: 'bold', letterSpacing: 1.5 }}>判断 1 · 位置</Text>
                    <Text style={{ fontSize: 14, color: '#1A1A1A', marginTop: 6, lineHeight: 1.55, fontWeight: 'bold' }}>
                        算法层是"调度语言"，先把语言定义清楚，控制器才能听懂、执行层才能听话
                    </Text>
                    <Text style={{ fontSize: 12, color: '#475569', marginTop: 4, lineHeight: 1.5 }}>
                        原理：上层做的是"今天这一小时最优计划"（小时级），下层要的是"下一秒具体动作"（秒级）——没有中间这层翻译，两者时间粒度和语义都对不上
                    </Text>
                </Box>
                <Box style={{ flex: 1, padding: '12px 16px', background: '#F8FAFC', borderRadius: 8, borderLeft: '3px solid #06B6D4' }}>
                    <Text style={{ fontSize: 13, color: '#06B6D4', fontWeight: 'bold', letterSpacing: 1.5 }}>判断 2 · 次序</Text>
                    <Text style={{ fontSize: 14, color: '#1A1A1A', marginTop: 6, lineHeight: 1.55, fontWeight: 'bold' }}>
                        算法层内部 4 个子件必须按顺序构建：先有"说话人"，再定"话术"，再设"议事厅"，最后订"议事规则"
                    </Text>
                    <Text style={{ fontSize: 12, color: '#475569', marginTop: 4, lineHeight: 1.5 }}>
                        原理：每个子件都是下个的输入——没有共同语言就无法在议事厅里比较，没有议事厅规则就无对象可应用，反序则全部失效
                    </Text>
                </Box>
                <Box style={{ flex: 1, padding: '12px 16px', background: '#F8FAFC', borderRadius: 8, borderLeft: '3px solid #EF4444' }}>
                    <Text style={{ fontSize: 13, color: '#EF4444', fontWeight: 'bold', letterSpacing: 1.5 }}>判断 3 · 不可省略</Text>
                    <Text style={{ fontSize: 14, color: '#1A1A1A', marginTop: 6, lineHeight: 1.55, fontWeight: 'bold' }}>
                        缺了算法层，控制层只能做单点控制；缺了运行层，调度结果无人发布。每一层都不可省略
                    </Text>
                    <Text style={{ fontSize: 12, color: '#475569', marginTop: 4, lineHeight: 1.5 }}>
                        原理：算法层给"指令"，执行层给"实时动作"，运行层给"生命周期管理"——三者闭环，缺一就只是局部最优
                    </Text>
                </Box>
            </Box>

        </Box>

        {/* C 区：页脚 */}
        <Box style={{
            padding: '0 60px',
            height: 50,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                工商业储能 EMS · 周期 1-4 交付汇报
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                02 / 11
            </Text>
        </Box>

    </Box>
</Slide>
