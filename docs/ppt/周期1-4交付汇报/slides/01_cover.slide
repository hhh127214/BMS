<Slide padding={0}>

    {/* 主体白底 */}
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        flexDirection: 'column',
        padding: 0,
    }}>

        {/* 蓝色梯形主视觉，左下大色块 */}
        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            width: 720,
            height: 480,
            background: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)',
            opacity: 0.95,
            clipPath: 'polygon(0 35%, 100% 0, 100% 100%, 0 100%)',
        }} />

        {/* 右下：阶段标签 v1.0 */}
        <Box style={{
            position: 'absolute',
            top: 36,
            right: 48,
            padding: '10px 24px',
            borderRadius: 24,
            border: '1.5px solid #3B82F6',
            background: 'rgba(59,130,246,0.06)',
        }}>
            <Text style={{
                fontSize: 16,
                color: '#3B82F6',
                fontWeight: 'bold',
                letterSpacing: 1.5,
            }}>
                阶段 1/3 · 算法协商底座
            </Text>
        </Box>

        {/* 主标题 */}
        <Box style={{
            position: 'absolute',
            top: 120,
            left: 60,
            width: 680,
        }}>
            <Text style={{
                fontSize: 60,
                fontWeight: 'bold',
                color: '#1A1A1A',
                lineHeight: 1.1,
                letterSpacing: -1,
            }}>
                工商业储能
            </Text>

            <Text style={{
                fontSize: 60,
                fontWeight: 'bold',
                color: '#3B82F6',
                lineHeight: 1.1,
                letterSpacing: -1,
                marginTop: 4,
            }}>
                能量管理系统 · 第一阶段
            </Text>

            <Box style={{ marginTop: 24, width: 80, height: 4, background: '#3B82F6' }} />

            <Text style={{
                fontSize: 22,
                color: '#1A1A1A',
                lineHeight: 1.5,
                marginTop: 28,
                maxWidth: 620,
            }}>
                让 9 个业务意志用同一种语言说话、并在同一张调度台前面排队表决
                <br />
                <Text style={{ color: '#3B82F6', fontWeight: 'bold' }}>前 4 周交付的不是代码，是这套协商底座</Text>
            </Text>
        </Box>

        {/* 左下大数字三联 */}
        <Box style={{
            position: 'absolute',
            bottom: 56,
            left: 60,
            flexDirection: 'row',
            gap: 36,
        }}>
            <Box>
                <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'JetBrains Mono, monospace', lineHeight: 1 }}>
                    9
                </Text>
                <Text style={{ fontSize: 16, color: '#E0F2FE', marginTop: 8, letterSpacing: 1 }}>
                    个业务意志需要协商
                </Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'JetBrains Mono, monospace', lineHeight: 1 }}>
                    4
                </Text>
                <Text style={{ fontSize: 16, color: '#E0F2FE', marginTop: 8, letterSpacing: 1 }}>
                    周 · 4 个底层建设
                </Text>
            </Box>
            <Box>
                <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'JetBrains Mono, monospace', lineHeight: 1 }}>
                    17
                </Text>
                <Text style={{ fontSize: 16, color: '#E0F2FE', marginTop: 8, letterSpacing: 1 }}>
                    种业务冲突被验证
                </Text>
            </Box>
        </Box>

        {/* 页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 24,
            right: 48,
        }}>
            <Text style={{ fontSize: 14, color: '#64748B' }}>
                工程评审 · 2026-09-06（EMS = Energy Management System，能量管理系统）
            </Text>
        </Box>

    </Box>
</Slide>
