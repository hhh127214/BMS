<Slide padding={0}>

    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        flexDirection: 'column',
        padding: 0,
    }}>

        {/* A 区 */}
        <Box style={{ padding: '16px 60px 0', height: 60 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
                <Box>
                    <Text style={{ fontSize: 16, color: '#3B82F6', fontWeight: 'bold', letterSpacing: 2 }}>
                        后续路线 · WHAT REMAINS
                    </Text>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1A1A1A', marginTop: 4 }}>
                        算法层已经攒好——剩下 4 件事把系统从"算"走向"跑"
                    </Text>
                </Box>
                <Text style={{ fontSize: 14, color: '#94A3B8' }}>P10 / 11</Text>
            </Box>
        </Box>

        {/* B 区 */}
        <Box style={{
            flex: 1,
            padding: '12px 60px 0',
            flexDirection: 'row',
            gap: 16,
        }}>

            {/* 左：已完成 4 件在全图上的位置 */}
            <Box style={{ flex: 9 }}>
                <Text style={{ fontSize: 14, color: '#64748B', fontWeight: 'bold', letterSpacing: 1.5, marginBottom: 8 }}>
                    把当前 4 件放在系统全图上
                </Text>
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    border: '1px solid #E2E8F0',
                    padding: 16,
                    height: 460,
                }}>
                    <svg width='100%' height='100%' viewBox='0 0 850 430'>
                        {/* 感知层 */}
                        <rect x='10' y='20' width='830' height='46' rx='6' fill='#F1F5F9' stroke='#94A3B8' />
                        <text x='30' y='50' fill='#475569' fontSize='15' fontFamily='Source Han Sans SC' fontWeight='bold'>第一层 · 数据采集</text>
                        <text x='180' y='50' fill='#1A1A1A' fontSize='14' fontFamily='Source Han Sans SC'>已有采集数据</text>
                        <text x='820' y='50' textAnchor='end' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>历史数据，足够用</text>

                        {/* 算法层（已交付 — 重点高亮）*/}
                        <rect x='10' y='85' width='830' height='100' rx='8' fill='#EFF6FF' stroke='#3B82F6' strokeWidth='3' />
                        <rect x='10' y='85' width='6' height='100' fill='#3B82F6' />
                        <text x='40' y='110' fill='#1E40AF' fontSize='16' fontFamily='Source Han Sans SC' fontWeight='bold'>第二层 · 经济调度</text>
                        <text x='40' y='130' fill='#1A1A1A' fontSize='14' fontFamily='Source Han Sans SC'>前 4 周交付：9 条诉求 / 共同语言 / 调度台 / 仲裁</text>
                        <text x='820' y='110' textAnchor='end' fill='#3B82F6' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>已交付</text>
                        <text x='820' y='130' textAnchor='end' fill='#1E40AF' fontSize='13' fontFamily='Source Han Sans SC'>21 个场景验证通过</text>

                        {/* 4 子盒 */}
                        <rect x='40' y='140' width='180' height='35' rx='4' fill='#FFFFFF' stroke='#3B82F6' />
                        <text x='130' y='162' textAnchor='middle' fill='#1E40AF' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>9 条业务诉求</text>
                        <rect x='230' y='140' width='180' height='35' rx='4' fill='#FFFFFF' stroke='#06B6D4' />
                        <text x='320' y='162' textAnchor='middle' fill='#0E7490' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>共同语言</text>
                        <rect x='420' y='140' width='180' height='35' rx='4' fill='#FFFFFF' stroke='#22C55E' />
                        <text x='510' y='162' textAnchor='middle' fill='#166534' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>调度台</text>
                        <rect x='610' y='140' width='220' height='35' rx='4' fill='#FFFFFF' stroke='#EF4444' />
                        <text x='720' y='162' textAnchor='middle' fill='#B91C1C' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>5 步仲裁</text>

                        {/* 执行层（部分有）*/}
                        <rect x='10' y='205' width='830' height='50' rx='6' fill='#F1F5F9' stroke='#94A3B8' />
                        <text x='30' y='234' fill='#475569' fontSize='15' fontFamily='Source Han Sans SC' fontWeight='bold'>第三层 · 实时执行</text>
                        <text x='180' y='234' fill='#1A1A1A' fontSize='14' fontFamily='Source Han Sans SC'>4 个实时控制器 — 已有原型</text>
                        <text x='820' y='234' textAnchor='end' fill='#64748B' fontSize='13' fontFamily='Source Han Sans SC'>有自测数据，等接算法</text>

                        {/* 运行层 — 缺口 */}
                        <rect x='10' y='275' width='830' height='50' rx='6' fill='#FEF3C7' stroke='#F59E0B' strokeWidth='2' />
                        <text x='30' y='304' fill='#92400E' fontSize='15' fontFamily='Source Han Sans SC' fontWeight='bold'>第四层 · 状态管理</text>
                        <text x='180' y='304' fill='#1A1A1A' fontSize='14' fontFamily='Source Han Sans SC'>状态机 / 启停 / 告警 — 还要做</text>
                        <text x='820' y='304' textAnchor='end' fill='#F59E0B' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>待启动</text>

                        {/* 端到端 */}
                        <rect x='10' y='345' width='830' height='50' rx='6' fill='#FEF2F2' stroke='#EF4444' strokeWidth='2' />
                        <text x='30' y='374' fill='#B91C1C' fontSize='15' fontFamily='Source Han Sans SC' fontWeight='bold'>端到端联调 + 验收</text>
                        <text x='820' y='374' textAnchor='end' fill='#EF4444' fontSize='13' fontFamily='Source Han Sans SC' fontWeight='bold'>最终验收</text>
                    </svg>
                </Box>
            </Box>

            {/* 右：剩余 4 件事清单 */}
            <Box style={{ flex: 7, flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, color: '#64748B', fontWeight: 'bold', letterSpacing: 1.5, marginBottom: 8 }}>
                    剩 4 件——按业务因果排，不是按周排
                </Text>

                {[
                    {
                        tag: 'P6', color: '#F59E0B',
                        name: '建状态机',
                        why: '"什么时候算法层可以下手"',
                        detail: '把 INIT/就绪/正常/降级/故障/紧急 6 种状态写出来——告诉上层"现在能不能用仲裁出来的结果"',
                    },
                    {
                        tag: 'P8', color: '#06B6D4',
                        name: '接全局优化器',
                        why: '"把全局最优计划喂给算法层"',
                        detail: '策略 8 动态优化现在用经验区间；下一步接全局最优算法的精确数学结果，区间会更紧、更准',
                    },
                    {
                        tag: 'P11', color: '#EF4444',
                        name: '端到端联调',
                        why: '"从仿真到现场的真实链路"',
                        detail: '把仲裁器输出的功率指令真正下发到 4 个控制器，跑通一个完整工作日——把仿真结果变成真实节能',
                    },
                    {
                        tag: 'P12', color: '#1A1A1A',
                        name: '系统验收',
                        why: '"能不能上业主"',
                        detail: '4 层闭环在真实数据下的完整验收——通过即上线，否则回到 P6 修状态机',
                    },
                ].map((row, idx) => (
                    <Box key={idx} style={{
                        flex: 1,
                        padding: '10px 14px',
                        background: '#FFFFFF',
                        borderRadius: 8,
                        borderLeft: '4px solid ' + row.color,
                        marginBottom: 6,
                        flexDirection: 'row',
                        alignItems: 'center',
                    }}>
                        <Box style={{
                            width: 40, padding: '5px 0',
                            background: row.color, borderRadius: 4,
                            alignItems: 'center',
                            marginRight: 12,
                        }}>
                            <Text style={{
                                color: '#FFFFFF', fontSize: 13,
                                fontWeight: 'bold', textAlign: 'center',
                            }}>{row.tag}</Text>
                        </Box>
                        <Box style={{ flex: 1 }}>
                            <Box style={{ flexDirection: 'row', alignItems: 'baseline' }}>
                                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A1A1A' }}>
                                    {row.name}
                                </Text>
                                <Text style={{ fontSize: 12, color: row.color, marginLeft: 8, fontWeight: 'bold' }}>
                                    {row.why}
                                </Text>
                            </Box>
                            <Text style={{ fontSize: 12, color: '#475569', marginTop: 3, lineHeight: 1.45 }}>
                                {row.detail}
                            </Text>
                        </Box>
                    </Box>
                ))}
            </Box>

        </Box>

        {/* C 区 */}
        <Box style={{
            padding: '0 60px 10px',
            height: 46,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                路线 = 让算法从"会算"走到"会被系统生命周期正确调度"
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>10 / 11</Text>
        </Box>

    </Box>
</Slide>
