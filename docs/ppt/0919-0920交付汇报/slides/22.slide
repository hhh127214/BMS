            <Text style={{ fontSize: 14, color: '#1A1A1A', fontFamily: 'Microsoft YaHei', lineHeight: 1.6 }}>
                谷段电价 0.30 元时多买、峰段 1.20 元时少买；全天购电 5180.8 kWh，
                向电网倒送 0 kWh（不做不可控的倒送）。
            </Text>
        </Box>
    </Box>
    <Box style={{ height: 44, display: 'flex', flexDirection: 'row', gap: 16, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, color: '#64748B', fontFamily: 'Microsoft YaHei' }}>
